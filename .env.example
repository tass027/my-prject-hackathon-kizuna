# Copie ce fichier en .env.local et remplis les deux valeurs (Supabase > Project Settings > API).
# Sans ces valeurs, l'application tourne en MODE LOCAL : tout marche sauf le partage Kizuna entre téléphones.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# La clé OpenAI est un secret Supabase Edge Function, jamais une variable VITE_*.
